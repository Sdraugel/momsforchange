{
  // Static-assets-only Worker (no server script): serves the prerendered
  // Angular build output. `npx wrangler deploy` uploads ./dist/.../browser.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momsforchange",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist/moms-for-change/browser",
    // Single page: serve index.html for unknown paths instead of a hard 404.
    "not_found_handling": "single-page-application"
  }
}
